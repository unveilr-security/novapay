# NovaPay environment (example) — AI provider keys.
# ⚠️ Real keys must live in a secret manager, never in the repo.
OPENAI_API_KEY=sk-proj-REPLACE_ME
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME
AZURE_OPENAI_API_KEY=REPLACE_ME
AZURE_OPENAI_ENDPOINT=https://novapay-support.openai.azure.com
COHERE_API_KEY=REPLACE_ME
GROQ_API_KEY=gsk_REPLACE_ME
DATABASE_URL=postgres://novapay@ledger.novapay.example:5432/ledger

# --- Unveilr (CI upload / CLI) ------------------------------------------------
# Mint under console Settings → API Tokens. Used by .github/workflows/unveilr.yml
# and `unveilr login --token`.
# UNVEILR_API=https://YOUR_API_HOST          # api.unveilr.ai not DNS-live yet
# UNVEILR_CONSOLE=https://guard.unveilr.ai   # hosted console (live)
# UNVEILR_TOKEN=uvt_REPLACE_ME

